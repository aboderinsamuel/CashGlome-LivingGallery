{
  "name": "cashglome",
  "productName": "CashGlome",
  "version": "4.0.0",
  "license": "Apache-2.0",
  "description": "CashGlome: your money, painted. A living money world.",
  "author": "CashGlome",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:parser": "node scripts/test-parser.mjs",
    "export:cases": "node scripts/export-cases.mjs",
    "serve": "node server.mjs",
    "desktop": "vite build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist": "vite build && electron-builder --win --mac"
  },
  "build": {
    "appId": "app.cashglome.desktop",
    "productName": "CashGlome",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "CashGlome-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.11.17",
    "gifenc": "^1.0.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "firebase": "^13.3.0"
  }
}
