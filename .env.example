# Copy to .env.local and fill in. Never commit .env.local.
# Everything here that starts with VITE_ is built INTO the app, where anyone can read it.
# So only public values go here. Secrets (the Meta key, Supabase's service_role key) never do.

# Supabase (accounts + sync). From your project: Project Settings → API (or API Keys).
# The anon / publishable key is meant to be public: row-level security keeps each person's rows private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Shared Muse: the server function that holds your Meta key (it lives in Vercel as META_API_KEY).
# With this set, Muse is on for everyone without a key of their own.
VITE_MUSE_PROXY=https://cashglome.vercel.app/api/muse

# Spotify (optional): lets people pick from their own playlists.
VITE_SPOTIFY_CLIENT_ID=
