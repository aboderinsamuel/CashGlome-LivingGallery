# Copy to .env.local and fill in. Never commit .env.local.
# Everything here that starts with VITE_ is built INTO the app, where anyone can read it.
# So only public values go here. Secrets (Supabase's service_role key, the Spotify secret) never do.

# Supabase (accounts + sync). From your project: Project Settings → API (or API Keys).
# The anon / publishable key is meant to be public: row-level security keeps each person's rows private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Spotify (optional): lets people pick from their own playlists.
VITE_SPOTIFY_CLIENT_ID=
# Spotify search inside the app (server only, never VITE_): from developer.spotify.com → your app → Settings.
# Set both in Vercel → Project → Settings → Environment Variables. Without them, search hands over to Spotify's own.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Firebase AI Logic (hybrid AI: Gemini Nano on the device, Gemini in the cloud). From the Firebase console:
# Project settings → Your apps → Web app → config. These values are public by design; App Check guards the API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check with reCAPTCHA Enterprise (the site key, public). Local dev uses a debug token instead.
VITE_RECAPTCHA_SITE_KEY=
# Optional: the cloud fallback model (default gemini-3.5-flash-lite).
VITE_GEMINI_MODEL=
