# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (accounts + sync). From your project: Settings → API.
# The anon key is meant to be public: row-level security keeps each person's rows private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Spotify (optional): lets people pick from their own playlists.
VITE_SPOTIFY_CLIENT_ID=
